#!/bin/sh
# Lanzador del shell. Equivale al makeWrapper de nix/default.nix, pero sobre la
# config de quickshell `caelestia` (/etc/xdg/quickshell/caelestia), que es donde
# la busca el CLI. Uso: `caelestia-shell -d`, `caelestia-shell ipc call ...`,
# `caelestia-shell kill`.
export CAELESTIA_LIB_DIR="${CAELESTIA_LIB_DIR:-/usr/lib/caelestia}"
exec /usr/bin/qs -c caelestia "$@"
